{
  "name": "@tenantscale/create-app",
  "version": "0.2.0",
  "description": "Scaffold a full-stack multi-tenant SaaS app with Next.js, Hono, and TenantScale",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "create-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "execa": "^10.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/create-app"
  },
  "keywords": [
    "multi-tenant",
    "saas",
    "scaffold",
    "starter",
    "create-app"
  ],
  "publishConfig": {
    "access": "public"
  }
}
