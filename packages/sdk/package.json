{
  "name": "@tenantscale/sdk",
  "version": "0.4.1",
  "description": "Framework-agnostic multi-tenant SDK for B2B SaaS — tenant isolation, audit logging, plan enforcement, and API key management.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsup src/index.ts --format cjs --out-dir dist --clean false",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "tsup": "^8.5.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "multi-tenant",
    "saas",
    "tenant-isolation",
    "b2b",
    "supabase"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
