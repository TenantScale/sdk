{
  "name": "@tenantscale/mcp",
  "version": "0.1.2",
  "description": "MCP server for TenantScale — gives AI coding tools real-time tenant context during development",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "tenantscale-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "^4.23.12",
    "@types/node": "26.2.0"
  },
  "keywords": [
    "tenantscale",
    "mcp",
    "ai",
    "multi-tenant",
    "claude",
    "cursor",
    "copilot"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
