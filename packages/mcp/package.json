{
  "name": "@tenantscale/mcp",
  "version": "0.1.2",
  "description": "MCP server for TenantScale — gives AI coding tools real-time tenant context during development",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tenantscale-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@supabase/supabase-js": "^2.115.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "^4.23.13",
    "@types/node": "26.6.4"
  },
  "keywords": [
    "tenantscale",
    "mcp",
    "ai",
    "multi-tenant",
    "claude",
    "cursor",
    "copilot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/TenantScale/sdk/issues"
  },
  "homepage": "https://github.com/TenantScale/sdk",
