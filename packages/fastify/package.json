{
  "name": "@tenantscale/fastify",
  "version": "0.1.1",
  "description": "Fastify middleware adapter for TenantScale — API key auth, plan enforcement, rate limiting, audit logging",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsup src/index.ts --format cjs --out-dir dist --clean false",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@tenantscale/sdk": "workspace:*"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fastify": "^5.12.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/fastify"
  },
  "keywords": [
    "multi-tenant",
    "saas",
    "fastify",
    "middleware",
    "tenant-isolation",
    "b2b",
    "tenantscale"
  ],
  "bugs": {
    "url": "https://github.com/TenantScale/sdk/issues"
  },
  "homepage": "https://github.com/TenantScale/sdk",
  "engines": {
    "node": ">=22"
  }
}
