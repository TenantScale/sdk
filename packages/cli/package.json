    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "multi-tenant",
    "saas",
    "cli",
    "scaffold",
    "tenantscale"
  ],
  "bugs": {
    "url": "https://github.com/TenantScale/sdk/issues"
  },
  "homepage": "https://github.com/TenantScale/sdk",
  "engines": {
    "node": ">=22"
