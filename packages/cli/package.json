{
  "name": "@tenantscale/cli",
  "version": "0.1.2",
  "description": "Scaffold multi-tenant SaaS projects with TenantScale",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tenantscale": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.0"
