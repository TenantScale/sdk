{
  "name": "@tenantscale/express",
  "version": "0.1.1",
  "description": "Express.js middleware adapter for TenantScale — API key auth, plan enforcement, rate limiting, audit logging",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsup src/index.ts --format cjs --out-dir dist --clean false",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "@tenantscale/sdk": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "express": "^5.2.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/express"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
