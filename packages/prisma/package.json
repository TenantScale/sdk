{
  "name": "@tenantscale/prisma",
  "version": "0.1.0",
  "description": "Prisma ORM tenant query guard for TenantScale",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/postbuild-cjs.mjs",
    "dev": "tsc -p tsconfig.esm.json --watch",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "lint": "oxlint src/"
  },
  "dependencies": {},
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TenantScale/sdk.git",
    "directory": "packages/prisma"
  },
  "engines": {
    "node": ">=22"
  }
}
