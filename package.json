{
  "name": "tenantscale-sdk",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint",
    "test": "turbo test",
    "prepare": "husky",
    "commitlint": "commitlint",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "^1.86.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.10",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.28.1"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  }
}
